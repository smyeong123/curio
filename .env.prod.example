# Production env template — copy to .env.prod and fill in every CHANGE_ME.
# Run: docker compose --env-file .env.prod up -d
# Local dev does not use this file — see .env.dev.example (infra stack)
# and backend/.env.example (backend keys).

# Database
POSTGRES_DB=curio
POSTGRES_USER=curio_user
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
# Optional: session length in ms (sliding idle timeout). Default 10800000 = 3 hours.
# JWT_REFRESH_EXPIRATION=10800000

# Google OAuth (client id only — ID-token flow, no secret needed by the backend)
GOOGLE_CLIENT_ID=

# AI Provider (claude | gemini | openai)
AI_PROVIDER=claude
CLAUDE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# News
NEWS_API_KEY=

# App URLs
FRONTEND_URL=https://curio-news.dev
BACKEND_URL=https://curio-news.dev
UNSUBSCRIBE_SECRET=CHANGE_ME

# TLS — required when running with docker-compose.tls.yml (Caddy + Let's Encrypt).
# docker-compose.tls.yml uses `:?` fail-fast, so leaving these unset prevents `up`.
CURIO_DOMAIN=curio-news.dev
ACME_EMAIL=ops@curio-news.dev

# TLS (Cloudflare origin) — required only with docker-compose.cf-tls.yml, the
# alternative to the Caddy overlay for a Cloudflare-proxied origin. Host directory
# holding the Cloudflare Origin Certificate as origin.pem + origin.key (key chmod
# 600). The overlay fails fast if unset. See docs/DEPLOY.md "Cloudflare origin TLS".
TLS_CERT_DIR=/etc/curio/tls

# BYOK at-rest encryption — generate with: openssl rand -base64 32
# Required in prod: app fails to start without it. Dev fallback exists.
# DO NOT lose this key — losing it makes all stored user API keys unrecoverable.
API_KEY_ENCRYPTION_KEY=CHANGE_ME

# Frontend
FRONTEND_PORT=80

# Optional — error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: use pre-built images instead of building locally
# BACKEND_IMAGE=ghcr.io/your-org/curio-backend:latest
# FRONTEND_IMAGE=ghcr.io/your-org/curio-frontend:latest
