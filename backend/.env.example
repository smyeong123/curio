# Backend environment variables for local development
# Copy to .env and fill in API keys
# DB and Redis use defaults from application-dev.yml (localhost:5432, localhost:6379)

# Google OAuth (client id only — ID-token flow, no secret needed by the backend)
GOOGLE_CLIENT_ID=your-google-client-id

# AI Provider (claude | gemini | openai)
AI_PROVIDER=claude
CLAUDE_API_KEY=your-claude-api-key
GEMINI_API_KEY=
OPENAI_API_KEY=

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret

# News
NEWS_API_KEY=your-news-api-key
